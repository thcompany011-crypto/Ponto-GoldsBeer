rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.cargo == "admin";
    }

    function isDono(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /usuarios/{userId} {
      allow read: if isDono(userId) || isAdmin();
      // Um usuário comum pode ler seu próprio perfil, mas só admin pode criar/editar
      // (evita que um colaborador se autopromova a admin editando o próprio documento).
      allow create, update, delete: if isAdmin();
    }

    match /batidas/{batidaId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());

      // Validação de schema: garante que não seja possível gravar lixo no banco
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.uid || isAdmin())
        && request.resource.data.tipo in ["Entrada", "Saída"]
        && request.resource.data.uid is string
        && request.resource.data.data is string;

      allow update, delete: if isAdmin();
    }

    // Coleção opcional de feriados, usada pelo cálculo de jornada (dia sem carga prevista).
    // Somente leitura para autenticados; escrita só por admin.
    match /feriados/{feriadoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Solicitações de ajuste de ponto: o colaborador cria a própria solicitação
    // (sempre como "pendente"); só admin pode aprovar/rejeitar (update).
    // O colaborador pode cancelar (delete) só enquanto ainda estiver pendente.
    match /solicitacoes/{solicitacaoId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pendente"
        && request.resource.data.acao in ["criar", "editar", "excluir"];

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid
        && resource.data.status == "pendente";

      allow update: if isAdmin();
    }
  }
}
