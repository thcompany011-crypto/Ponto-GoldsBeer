rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.cargo == "admin";
    }

    // Cada usuário só pode ler/gravar dentro da própria pasta (ex: /usuarios/UID/foto.jpg).
    // Admin pode acessar qualquer pasta (ex: para relatórios exportados, comprovantes, etc.).
    match /usuarios/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Bloqueia por padrão qualquer outro caminho fora de /usuarios/{uid}/...
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
